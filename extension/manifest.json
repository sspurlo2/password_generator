{
  "manifest_version": 3,
  "name": "Memorable Password Generator",
  "version": "1.0.2",
  "default_locale": "en",
  "icons": {
    "128": "/icons/icon_128.png"
  },
  "description": "Generate passwords and passphrases that are memorable, personalized, and secure.",
  "action": {
    "default_title": "Password Tool",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
